        ArrayDeque<Position> pending=new ArrayDeque<>();
        for(int start=0;start<values.size();start++) {
            if(state[start]==2) continue;pending.push(new Position(start,0));
            while(!pending.isEmpty()) {
                Position position=pending.pop();int index=position.index();state[index]=1;
                List<Integer> links=values.get(index).links();
                if(position.next()==links.size()) { state[index]=2;result.add(index);continue; }
                pending.push(new Position(index,position.next()+1));int child=links.get(position.next());
                if(state[child]==1) throw new IllegalArgumentException("Cyclic metadata containers need symbolic node references");
                if(state[child]==0) pending.push(new Position(child,0));
            }
        }
        return result;
    }

