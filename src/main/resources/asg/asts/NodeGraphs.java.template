        for(var node:owned(root).nodes()) __PREFIX__NodeCodec.encode(node,new __PREFIX__NodeCodec.Encoder<Integer>() {
            public Integer child(__PREFIX__Element value) { return 0; }
            public Integer reference(__PREFIX__Element value) { return reference("node reference",value); }
            public Integer reference(String field,__PREFIX__Element value) { if(value!=null) visitor.accept(field,value);return 0; }
            public Integer externalReference(String field,Object value) { if(value!=null) visitor.accept(field,value);return 0; }
